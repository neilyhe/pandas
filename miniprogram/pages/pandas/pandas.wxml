<view class="page">
  <block wx:if="{{viewState === 'loading'}}">
    <view class="state">
      <view class="spinner"></view>
      <text class="state-text">正在加载熊猫图鉴…</text>
    </view>
  </block>

  <block wx:elif="{{viewState === 'error'}}">
    <view class="state">
      <text class="state-emoji">🐼</text>
      <text class="state-text">{{errorMsg}}</text>
      <button class="retry" bindtap="fetch">重试</button>
    </view>
  </block>

  <block wx:elif="{{viewState === 'empty'}}">
    <view class="state">
      <text class="state-emoji">🎋</text>
      <text class="state-text">图鉴还没有收录熊猫</text>
    </view>
  </block>

  <block wx:else>
    <view class="top-bg">
      <text class="top-deco d1">🐾</text>
      <text class="top-deco d2">🎋</text>
      <text class="top-title">熊猫图鉴</text>
      <text class="top-sub">点开卡片，看看每一位顶流的小档案</text>
    </view>

    <view class="grid">
      <view
        class="cell"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openPanda"
        hover-class="cell-hover"
      >
        <view class="cell-media">
          <image class="cell-img" src="{{item.avatar}}" mode="aspectFill" lazy-load />
          <view class="cell-shade"></view>
          <text class="cell-gender" wx:if="{{item.gender}}">{{item.gender}}</text>
          <view class="cell-name-row">
            <text class="cell-name">{{item.name}}</text>
          </view>
        </view>
        <view class="cell-body">
          <text class="cell-base">📍 {{item.base}}</text>
          <text class="cell-go">看档案 →</text>
        </view>
      </view>
    </view>
  </block>
</view>
