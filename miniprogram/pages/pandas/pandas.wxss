.page {
  padding-bottom: 56rpx;
}
.top-bg {
  padding-bottom: 76rpx;
}
.top-title {
  font-size: 46rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 0 24rpx;
  margin-top: -52rpx;
}

.cell {
  width: calc(50% - 12rpx);
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.cell-hover {
  transform: scale(0.97);
  box-shadow: var(--shadow-md);
  transition: transform 0.12s ease;
}
.cell-media {
  position: relative;
}
.cell-img {
  width: 100%;
  height: 300rpx;
  display: block;
}
.cell-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(22, 19, 14, 0.68) 100%);
}
.cell-gender {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.cell-name-row {
  position: absolute;
  left: 22rpx;
  bottom: 18rpx;
}
.cell-name {
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}
.cell-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx 24rpx;
  gap: 12rpx;
}
.cell-base {
  color: var(--ink-2);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-go {
  flex-shrink: 0;
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
}
