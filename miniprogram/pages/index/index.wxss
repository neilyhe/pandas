.page {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页头（渐变），Banner 上浮压在页头上 */
.top-bg {
  padding-bottom: 96rpx;
}
.top-title {
  font-size: 46rpx;
}
.banner {
  height: 420rpx;
  margin: -76rpx 24rpx 0;
}

/* 胶囊指示点（卡片下方） */
.banner-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 0 0;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(47, 74, 56, 0.18);
  transition: width 0.3s ease, background 0.3s ease;
}
.dot.on {
  width: 40rpx;
  background: var(--brand);
}
.banner-card {
  position: relative;
  height: 100%;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}
.press {
  transform: scale(0.985);
}
.banner-img {
  width: 100%;
  height: 100%;
}
.banner-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 34%, rgba(22, 19, 14, 0.72) 100%);
}
.banner-ribbon {
  position: absolute;
  left: 26rpx;
  top: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
}
.banner-txt {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.banner-title {
  color: #fff;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.4;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.banner-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 23rpx;
}

.wrap {
  padding: 0 24rpx 48rpx;
}

/* 动态卡片 */
.list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}
.card {
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.card-hover {
  transform: scale(0.985);
  box-shadow: var(--shadow-md);
  transition: transform 0.12s ease;
}
.card-media {
  position: relative;
}
.card-img {
  width: 100%;
  height: 330rpx;
  display: block;
}
.card-shade {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(22, 19, 14, 0.28) 100%);
}
.like-badge {
  position: absolute;
  right: 22rpx;
  bottom: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--pink);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.card-body {
  padding: 26rpx 28rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-meta .date {
  margin-left: auto;
  color: var(--ink-3);
  font-size: 22rpx;
}
.card-title {
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.45;
}
.card-summary {
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.foot {
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
  padding: 24rpx 0 8rpx;
}
