<view class="page">
  <block wx:if="{{viewState === 'loading'}}">
    <view class="state">
      <view class="spinner"></view>
      <text class="state-text">正在加载最新动态…</text>
    </view>
  </block>

  <block wx:elif="{{viewState === 'error'}}">
    <view class="state">
      <text class="state-emoji">🐼</text>
      <text class="state-text">{{errorMsg}}</text>
      <button class="retry" bindtap="reload">重试</button>
    </view>
  </block>

  <block wx:elif="{{viewState === 'empty'}}">
    <view class="state">
      <text class="state-emoji">🎋</text>
      <text class="state-text">还没有动态，过阵子再来看看</text>
    </view>
  </block>

  <block wx:else>
    <view class="top-bg">
      <text class="top-deco d1">🎋</text>
      <text class="top-deco d2">🐼</text>
      <text class="top-title">熊猫动态圈</text>
      <text class="top-sub">今日份的滚滚新鲜事，都在这里 🎋</text>
    </view>

    <swiper
      wx:if="{{banners.length}}"
      class="banner"
      current="{{bannerCur}}"
      bindchange="onBannerChange"
      autoplay
      circular
      interval="4200"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-card" data-id="{{item.id}}" bindtap="openDetail" hover-class="press">
          <image class="banner-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <view class="banner-shade"></view>
          <view class="banner-ribbon">置顶</view>
          <view class="banner-txt">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-sub" wx:if="{{item.pandaName}}">聚焦 · {{item.pandaName}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="banner-dots" wx:if="{{banners.length > 1}}">
      <view
        class="dot {{bannerCur === index ? 'on' : ''}}"
        wx:for="{{banners}}"
        wx:key="id"
      ></view>
    </view>

    <view class="wrap">
      <view class="sec-head">
        <view class="sec-bar"></view>
        <text class="sec-title">最新动态</text>
      </view>

      <view class="list">
        <view
          class="card"
          wx:for="{{items}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="openDetail"
          hover-class="card-hover"
        >
          <view class="card-media">
            <image class="card-img" src="{{item.cover}}" mode="aspectFill" lazy-load />
            <view class="card-shade"></view>
            <view class="like-badge" wx:if="{{item.likes}}">♥ {{item.likes}}</view>
          </view>
          <view class="card-body">
            <view class="card-meta">
              <text class="chip" wx:if="{{item.tag}}">{{item.tag}}</text>
              <text class="chip panda" wx:if="{{item.pandaName}}">{{item.pandaName}}</text>
              <text class="date">{{item.dateText}}</text>
            </view>
            <text class="card-title">{{item.title}}</text>
            <text class="card-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
          </view>
        </view>

        <view class="foot">
          <text wx:if="{{loadingMore}}">加载中…</text>
          <text wx:elif="{{!hasMore}}">🎋 到底啦，去图鉴逛逛吧</text>
        </view>
      </view>
    </view>
  </block>
</view>
