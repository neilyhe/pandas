.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 大图 + 底部压暗 */
.hero-wrap {
  position: relative;
}
.hero {
  width: 100%;
  height: 520rpx;
  display: block;
}
.hero-shade {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(22, 19, 14, 0.4) 100%);
}

/* 白色圆角卡片上浮 */
.body {
  position: relative;
  margin-top: -56rpx;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 40rpx 56rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  box-shadow: var(--shadow-md);
}

.meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.meta .date {
  margin-left: auto;
  color: var(--ink-3);
  font-size: 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.45;
  letter-spacing: 1rpx;
}

/* 引用式摘要 */
.summary {
  position: relative;
  background: var(--brand-soft);
  border-radius: 20rpx;
  padding: 22rpx 26rpx 22rpx 30rpx;
}
.summary::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: var(--brand);
}
.summary-txt {
  color: var(--brand-deep);
  font-size: 27rpx;
  line-height: 1.7;
}

.paragraphs {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  padding-top: 6rpx;
}
.para {
  font-size: 30rpx;
  line-height: 1.9;
  color: var(--ink);
  text-align: justify;
}

/* 点赞按钮 */
.like-row {
  display: flex;
  justify-content: center;
  padding-top: 14rpx;
}
.like {
  background: var(--pink-soft);
  color: var(--pink);
  font-size: 29rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 20rpx 68rpx;
  box-shadow: var(--shadow-sm);
}
.like.on {
  background: var(--pink);
  color: #fff;
}
.like.dim {
  opacity: 0.6;
}

.extras {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 8rpx;
}
.extra-img {
  width: 100%;
  border-radius: 24rpx;
  display: block;
  box-shadow: var(--shadow-sm);
}

.end {
  text-align: center;
  color: var(--ink-3);
  font-size: 23rpx;
  letter-spacing: 4rpx;
  padding-top: 36rpx;
}
